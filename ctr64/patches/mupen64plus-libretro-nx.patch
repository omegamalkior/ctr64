+#if defined(__3DS__)
+/* ctr64: writeToRdram with an inlined converter and no tester (every pixel stored) */
+template <typename TSrc, typename TDst, typename Conv>
+void writeToRdramInline(const TSrc* _src, TDst* _dst, Conv converter, u32 _xor, u32 _width, u32 _height,
+	u32 _numPixels, u32 _startAddress, u32 _bufferAddress, u32 _bufferSize)
+{
+	u32 chunkStart = ((_startAddress - _bufferAddress) >> (_bufferSize - 1)) % _width;
+	if (chunkStart % 2 != 0) {
+		--chunkStart;
+		--_dst;
+		++_numPixels;
+	}
+
+	u32 numStored = 0;
+	u32 y = 0;
+	if (chunkStart > 0) {
+		for (u32 x = chunkStart; x < _width; ++x) {
+			_dst[numStored ^ _xor] = converter(_src[x]);
+			++numStored;
+		}
+		++y;
+		_dst += numStored;
+	}
+
+	u32 dsty = 0;
+	for (; y < _height && numStored < _numPixels; ++y, ++dsty) {
+		const u32 n = std::min(_width, _numPixels - numStored);
+		const TSrc* s = _src + y * _width;
+		TDst* d = _dst + dsty * _width;
+		u32 x = 0;
+		if (_xor == 1 && sizeof(TDst) == 2 && ((dsty * _width) & 1) == 0) {
+			for (; x + 1 < n; x += 2) { /* pairs: dst word holds (x+1, x) */
+				d[x] = converter(s[x + 1]);
+				d[x + 1] = converter(s[x]);
+			}
+		}
+		for (; x < n; ++x)
+			_dst[(x + dsty * _width) ^ _xor] = converter(s[x]);
+		numStored += n;
+	}
+}
+#endif
+
 #endif // WriteToRDRAM_H
