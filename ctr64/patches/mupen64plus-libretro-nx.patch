+/* what get_addr & co do with a block that is not compiled yet: NULL compiles it here */
+static void *ctr64_before_compile(u_int vaddr)
+{
+  if(ctr64_ct_on!=(ctr64_ct_started&&ctr64_jit_thread_want)) {
+    ctr64_ct_sync(); /* switched in the menu: none in flight from here on */
+    ctr64_ct_on=ctr64_ct_started&&ctr64_jit_thread_want;
+  }
+  if(ctr64_ct_on) {
+    if(ctr64_ct_usable(vaddr)>0) {
+      if(!ctr_jit_thread_busy) {
+        ctr64_ct_finish();
+        ctr64_ct_post(vaddr);
+      }
+      return ctr64_interp_entry(vaddr);
+    }
+    ctr64_ct_sync();
+    return NULL;
+  }
+  if(ctr64_interp_wanted(vaddr)>0) return ctr64_interp_entry(vaddr);
+  return NULL;
+}
