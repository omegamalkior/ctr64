+/* what get_addr & co return for code to interpret: the stub saves the cycle count, calls
+ * ctr64_interp_run and jumps where it says */
+static void *ctr64_interp_entry(u_int vaddr)
+{
+  ctr64_interp_pc=vaddr;
+  return (void *)ctr64_interp_stub;
+}
