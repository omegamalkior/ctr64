+/* whether to interpret the code at vaddr instead of compiling it (counts the entry): its
+ * instruction count, 0 when it cannot be interpreted, -1 when it is hot */
+static int ctr64_interp_wanted(u_int vaddr)
+{
+  struct r4300_core* r4300=&g_dev.r4300;
+  if(ctr64_force_compile) { ctr64_force_compile=0; return 0; }
+  if(!ctr64_interp_tier||(vaddr&0xC0000003)!=0x80000000) return 0;
+  if((vaddr&0x1FFFFFFF)>=0x00800000) return 0; /* RDRAM only */
+  if(savestates_get_job()!=savestates_job_nothing||r4300->reset_hard_job) return 0;
+  const uint32_t *p=fast_mem_access(r4300,vaddr);
+  if(!p) return 0;
+  const u_int slot=((vaddr>>2)^(vaddr>>16))&16383;
+  __typeof__(ctr64_entries[0]) *e=&ctr64_entries[slot];
+  if(e->vaddr!=vaddr||(e->n&&(p[0]!=e->w0||p[e->n-1]!=e->wl))) {
+    e->vaddr=vaddr;
+    e->count=0;
+    e->n=(unsigned short)ctr64_interp_scan(r4300,vaddr);
+    e->w0=p[0];
+    e->wl=e->n?p[e->n-1]:0;
+  }
+  if(!e->n) return 0;
+  if(e->count>=CTR64_HOT_ENTRIES) return -1;
+  e->count++;
+  return e->n;
+}
+
+/* for the compile thread mode: how many instructions of vaddr's block the interpreter may run
+ * (scan cached in ctr64_entries), 0 when it must be compiled */
+static int ctr64_ct_usable(u_int vaddr)
+{
+  struct r4300_core* r4300=&g_dev.r4300;
+  if((vaddr&0xC0000003)!=0x80000000||(vaddr&0x1FFFFFFF)>=0x00800000) return 0; /* RDRAM, KSEG0 */
+  if(savestates_get_job()!=savestates_job_nothing||r4300->reset_hard_job) return 0;
+  const uint32_t *p=fast_mem_access(r4300,vaddr);
+  if(!p) return 0;
+  const u_int slot=((vaddr>>2)^(vaddr>>16))&16383;
+  __typeof__(ctr64_entries[0]) *e=&ctr64_entries[slot];
+  if(e->vaddr!=vaddr||(e->n&&(p[0]!=e->w0||p[e->n-1]!=e->wl))) {
+    e->vaddr=vaddr;
+    e->count=0;
+    e->n=(unsigned short)ctr64_interp_scan(r4300,vaddr);
+    e->w0=p[0];
+    e->wl=e->n?p[e->n-1]:0;
+  }
+  return e->n;
+}
+
+/* the scan of vaddr's block, as ctr64_interp_wanted left it */
+static int ctr64_interp_entries_n(u_int vaddr)
+{
+  const u_int slot=((vaddr>>2)^(vaddr>>16))&16383;
+  return ctr64_entries[slot].vaddr==vaddr?ctr64_entries[slot].n:0;
+}
+
+/* the compiled block at vaddr, if there is one (get_addr without compiling) */
+static void *ctr64_lookup(u_int vaddr)
+{
+  struct r4300_core* r4300=&g_dev.r4300;
+  struct ll_entry **ht_bin=hash_table[((vaddr>>16)^vaddr)&0xFFFF];
+  struct ll_entry *head=get_clean(r4300,vaddr,~0);
+  if(head!=NULL) {
+    ht_bin[1]=ht_bin[0];
+    ht_bin[0]=head;
+    return (void*)(((intptr_t)head->addr-(intptr_t)base_addr)+(intptr_t)base_addr_rx);
+  }
+  head=get_dirty(r4300,vaddr,~0);
+  if(head!=NULL) {
+    if(ht_bin[0]&&ht_bin[0]->vaddr==vaddr) ht_bin[0]=head;
+    else { ht_bin[1]=ht_bin[0]; ht_bin[0]=head; }
+    return (void*)(((intptr_t)head->clean_addr-(intptr_t)base_addr)+(intptr_t)base_addr_rx);
+  }
+  return NULL;
+}
