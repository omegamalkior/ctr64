+/* MIPS instructions the interpreter may run here up to the end of the basic block at vaddr
+ * (with its delay slot), or 0 when the block must be compiled */
+static int ctr64_interp_scan(struct r4300_core* r4300,u_int vaddr)
+{
+  const uint32_t *p=fast_mem_access(r4300,vaddr);
+  if(!p) return 0;
+  const int room=(int)((0x1000-(vaddr&0xFFF))>>2); /* stay in the page */
+  for(int k=0;k<CTR64_MAX_BLOCK&&k<room;k++) {
+    const uint32_t op=p[k], major=op>>26, pc=vaddr+k*4;
+    int branch=0, self=0;
+    switch(major) {
+      case 0x00: /* SPECIAL */
+        switch(op&0x3F) {
+          case 0x08: case 0x09: branch=1; break;           /* JR, JALR */
+          case 0x0C: case 0x0D: return 0;                  /* SYSCALL, BREAK */
+          case 0x30: case 0x31: case 0x32: case 0x33: case 0x34: case 0x36: return 0; /* traps */
+        }
+        break;
+      case 0x01: /* REGIMM */
+        switch((op>>16)&0x1F) {
+          case 0x00: case 0x01: case 0x02: case 0x03:
+          case 0x10: case 0x11: case 0x12: case 0x13: branch=1; self=(op&0xFFFF)==0xFFFF; break;
+          default: return 0;                               /* traps */
+        }
+        break;
+      case 0x02: case 0x03: /* J, JAL */
+        branch=1; self=(((pc+4)&0xF0000000)|((op&0x3FFFFFF)<<2))==pc; break;
+      case 0x04: case 0x05: case 0x06: case 0x07:
+      case 0x14: case 0x15: case 0x16: case 0x17: /* branches, branch likely */
+        branch=1; self=(op&0xFFFF)==0xFFFF; break;
+      case 0x11: /* COP1: BC1F/BC1T/BC1FL/BC1TL */
+        if(((op>>21)&0x1F)==0x08) { branch=1; self=(op&0xFFFF)==0xFFFF; }
+        break;
+      case 0x10: case 0x12: case 0x13: case 0x1C: case 0x1D: case 0x1E: case 0x1F:
+      case 0x2F: case 0x3B: return 0;                      /* COP0, COP2, reserved, CACHE */
+    }
+    if(self) return 0;                                     /* idle loop */
+    if(branch) {
+      if(k+1>=room) return 0;                              /* delay slot in the next page */
+      const uint32_t ds=p[k+1], dmajor=ds>>26;
+      if(dmajor==0x10||dmajor==0x12||dmajor==0x13||(dmajor>=0x1C&&dmajor<=0x1F)||dmajor==0x2F||dmajor==0x3B) return 0;
+      if(dmajor==0x00&&(((ds&0x3F)>=0x0C&&(ds&0x3F)<=0x0D)||((ds&0x3F)>=0x30&&(ds&0x3F)<=0x36))) return 0;
+      if(dmajor==0x01&&((ds>>16)&0x1F)>=0x08&&((ds>>16)&0x1F)<=0x0E) return 0;
+      return k+1; /* the branch runs its delay slot itself */
+    }
+  }
+  return room<CTR64_MAX_BLOCK?room:CTR64_MAX_BLOCK;
+}
