new file mode 100644
index 0000000..dc7562d
--- /dev/null
+++ b/GLideN64/src/Ctr64Prof.h
@@ -0,0 +1,28 @@
+#pragma once
+/* ctr64 profiling: inclusive time per scope, read by ctr64's stats.log (ctr64/src/main.c) */
+#ifdef __3DS__
+extern "C" unsigned long long svcGetSystemTick(void);
+extern "C" unsigned long long ctr64_prof_ticks[48];
+extern "C" unsigned int ctr64_prof_calls[48];
+extern "C" unsigned long long ctr64_prof_total[48]; /* never reset: per-VI deltas (prof.c) */
+extern "C" int ctr64_prof_on; /* timers on: each tick read is a kernel call, thousands per frame */
+struct Ctr64ProfScope {
+	int id;
+	unsigned long long t0;
+	explicit Ctr64ProfScope(int _id) : id(_id), t0(ctr64_prof_on ? svcGetSystemTick() : 0) {}
+	~Ctr64ProfScope() { end(); }
+	void end()
+	{
+		if (t0) {
+			const unsigned long long d = svcGetSystemTick() - t0;
+			ctr64_prof_ticks[id] += d;
+			ctr64_prof_total[id] += d;
+			ctr64_prof_calls[id]++;
+			t0 = 0;
+		}
+	}
+};
+#define CTR64_PROF(id) Ctr64ProfScope ctr64_prof_scope_(id)
+#else
