@@ -0,0 +1,107 @@
+#ifndef CTR64_WORDS_H
+#define CTR64_WORDS_H
+/* ctr64 (3DS, ARM11): word runs compared / filled 8 words per load/store-multiple.
+ * Used by the frame buffer validity checks (FrameBuffer::isValid, every VI) and RDRAM fills
+ * (FrameBufferList::fillRDRAM, every clear). Answers are the same as the plain loops:
+ * the scans only skip groups whose words are all exactly equal; every other group is left to
+ * the caller's exact (masked) count. */
+
+
+#if defined(__3DS__) && defined(__arm__) && !defined(__thumb__)
+/* First 8-word group at or after p (p..end, end - p a multiple of 8 words) that is not entirely
+ * equal to v; end if all are. */
+static inline const unsigned int *ctr64_skip_eq8(const unsigned int *p, const unsigned int *end, unsigned int v)
+{
+	__asm__ volatile(
+		"1:\n\t"
+		"cmp     %[p], %[end]\n\t"
+		"bhs     2f\n\t"
+		"ldm     %[p], {r4, r5, r6, r7, r8, r9, r10, r12}\n\t"
+		"teq     r4, %[v]\n\t"
+		"teqeq   r5, %[v]\n\t"
+		"teqeq   r6, %[v]\n\t"
+		"teqeq   r7, %[v]\n\t"
+		"teqeq   r8, %[v]\n\t"
+		"teqeq   r9, %[v]\n\t"
+		"teqeq   r10, %[v]\n\t"
+		"teqeq   r12, %[v]\n\t"
+		"addeq   %[p], %[p], #32\n\t"
+		"beq     1b\n\t"
+		"2:\n\t"
+		: [p] "+r"(p)
+		: [end] "r"(end), [v] "r"(v)
+		: "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r12", "cc", "memory");
+	return p;
+}
+
+/* First 4-word group at or after a (a..aend, a multiple of 4 words) where a differs from b
+ * (b advances with a); aend if none. */
+static inline const unsigned int *ctr64_skip_same4(const unsigned int *a, const unsigned int *aend, const unsigned int *b)
+{
+	__asm__ volatile(
+		"1:\n\t"
+		"cmp     %[a], %[aend]\n\t"
+		"bhs     2f\n\t"
+		"ldm     %[a], {r4, r5, r6, r7}\n\t"
+		"ldm     %[b], {r8, r9, r10, r12}\n\t"
+		"teq     r4, r8\n\t"
+		"teqeq   r5, r9\n\t"
+		"teqeq   r6, r10\n\t"
+		"teqeq   r7, r12\n\t"
+		"addeq   %[a], %[a], #16\n\t"
+		"addeq   %[b], %[b], #16\n\t"
+		"beq     1b\n\t"
+		"2:\n\t"
+		: [a] "+r"(a), [b] "+r"(b)
+		: [aend] "r"(aend)
+		: "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r12", "cc", "memory");
+	return a;
+}
+
+/* p[0..n) = v */
+static inline void ctr64_fill_words(unsigned int *p, unsigned int n, unsigned int v)
+{
+	unsigned int *e8 = p + (n & ~7u);
+	if (p != e8) {
+		__asm__ volatile(
+			"mov     r4, %[v]\n\t"
+			"mov     r5, %[v]\n\t"
+			"mov     r6, %[v]\n\t"
+			"mov     r7, %[v]\n\t"
+			"mov     r8, %[v]\n\t"
+			"mov     r9, %[v]\n\t"
+			"mov     r10, %[v]\n\t"
+			"mov     r12, %[v]\n\t"
+			"1:\n\t"
+			"stmia   %[p]!, {r4, r5, r6, r7, r8, r9, r10, r12}\n\t"
+			"cmp     %[p], %[e]\n\t"
+			"blo     1b\n\t"
+			: [p] "+r"(p)
+			: [e] "r"(e8), [v] "r"(v)
+			: "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r12", "cc", "memory");
+	}
+	for (unsigned int i = 0; i < (n & 7u); ++i)
+		p[i] = v;
+}
+#else
+static inline const unsigned int *ctr64_skip_eq8(const unsigned int *p, const unsigned int *end, unsigned int v)
+{
+	while (p < end && p[0] == v && p[1] == v && p[2] == v && p[3] == v && p[4] == v && p[5] == v &&
+		   p[6] == v && p[7] == v)
+		p += 8;
+	return p;
+}
+static inline const unsigned int *ctr64_skip_same4(const unsigned int *a, const unsigned int *aend, const unsigned int *b)
+{
+	while (a < aend && a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3])
+		a += 4, b += 4;
+	return a;
+}
+static inline void ctr64_fill_words(unsigned int *p, unsigned int n, unsigned int v)
+{
+	for (unsigned int i = 0; i < n; ++i)
+		p[i] = v;
+}
+#endif
+
+#endif
