+       * compiling the hot spot on its own would compile the function's code twice */
+      ctr64_force_compile=1;
+      get_addr(entry);
+      void *a=ctr64_lookup(pc);
+      if(a) return a;
+    }
+    if(n<=0) return get_addr(pc);
+  }
+}
