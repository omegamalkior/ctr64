+#if defined(__3DS__)
+void* adopt_mem_rom(void* buffer, uint32_t size);
+void* borrow_mem_rom(void* buffer, uint32_t size);
+
+/* ctr64: the cartridge ROM streamed from the SD card (ctr64/src/rom_stream.c). While
+ * ctr64_rs_active, only the first 64 KB page is at the ROM pointer; every other byte is read
+ * through ctr64_rs_ptr. */
+#define CTR64_RS_SHIFT 16
+#define CTR64_RS_PAGES 4032 /* 252 MB: the cartridge address range (ROM hacks over 64 MB) */
+extern int ctr64_rs_active;
+extern uint8_t* ctr64_rs_map[];
+extern uint32_t ctr64_rs_stamp[];
+extern uint32_t ctr64_rs_clock;
+extern char ctr64_rs_md5[33];
+const uint8_t* ctr64_rs_fault(uint32_t page);
+
+/* ROM byte at offset off, in the core's byte order; valid until the next page is brought in */
+static osal_inline const uint8_t* ctr64_rs_ptr(uint32_t off)
+{
+    const uint32_t pg = off >> CTR64_RS_SHIFT;
+    const uint32_t in = off & ((UINT32_C(1) << CTR64_RS_SHIFT) - 1);
+    if (pg >= CTR64_RS_PAGES)
+        return ctr64_rs_fault(pg) + in; /* past any cartridge: zeros */
+    const uint8_t* p = ctr64_rs_map[pg];
+    if (p == NULL)
+        p = ctr64_rs_fault(pg);
+    ctr64_rs_stamp[pg] = ++ctr64_rs_clock;
+    return p + in;
+}
+#endif
