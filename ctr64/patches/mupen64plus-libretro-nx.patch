+#ifdef __3DS__
+/* ctr64: XXH3-64 is built on 64x64-bit multiplies, slow on the 3DS's 32-bit ARM11. These hashes
+ * only key in-memory caches, so a 32-bit XXH32 of the data, chained through the seed, is enough. */
+static inline u32 xr(u32 v, int r) { return (v << r) | (v >> (32 - r)); }
+static inline u32 xrd(const u8 *p) { u32 v; memcpy(&v, p, 4); return v; }
+static inline u32 xround(u32 acc, u32 in) { return xr(acc + in * 0x85EBCA77U, 13) * 0x9E3779B1U; }
+static inline u32 xaval(u32 h)
+{
+	h ^= h >> 15; h *= 0x85EBCA77U; h ^= h >> 13; h *= 0xC2B2AE3DU; h ^= h >> 16;
+	return h;
+}
+
+/* two independent 32-bit lanes, each chained through its own half of the seed: a single
+ * XXH32 widened to 64 bits collided in SSB (a half-loaded texture was reused). Both lanes are
+ * XXH32 (bit for bit, see XXH32 in xxHash/xxhash.h), computed in one pass over the data: each
+ * word is loaded once for both. */
+extern "C" { unsigned ctr64_crc_long[2]; } /* calls >= 256 bytes, KB hashed (stats.log) */
+u64 CRC_Calculate( u64 crc, const void * buffer, u32 count )
+{
+	/* long inputs (texture data): XXH3's main loop is one 32x32->64 multiply (UMULL) per 8 bytes,
+	 * about half the work of the two XXH32 lanes; only its short-input paths and final mixing
+	 * use 64x64 multiplies, which are slow on the ARM11 */
+	if (count >= 256) {
+		ctr64_crc_long[0]++;
+		ctr64_crc_long[1] += count >> 10;
+		return XXH3_64bits_withSeed(buffer, count, crc);
+	}
+	const u32 P1 = 0x9E3779B1U, P2 = 0x85EBCA77U, P3 = 0xC2B2AE3DU, P4 = 0x27D4EB2FU, P5 = 0x165667B1U;
+	const u32 sa = static_cast<u32>(crc), sb = static_cast<u32>(crc >> 32) ^ 0x9E3779B1U;
+	const u8 *p = static_cast<const u8*>(buffer);
+	const u8 *const end = p + count;
+	u32 ha, hb;
+	if (count >= 16) {
+		u32 a1 = sa + P1 + P2, a2 = sa + P2, a3 = sa, a4 = sa - P1;
+		u32 b1 = sb + P1 + P2, b2 = sb + P2, b3 = sb, b4 = sb - P1;
+		const u8 *const limit = end - 16;
+		do {
+			const u32 w0 = xrd(p), w1 = xrd(p + 4), w2 = xrd(p + 8), w3 = xrd(p + 12);
+			a1 = xround(a1, w0); b1 = xround(b1, w0);
+			a2 = xround(a2, w1); b2 = xround(b2, w1);
+			a3 = xround(a3, w2); b3 = xround(b3, w2);
+			a4 = xround(a4, w3); b4 = xround(b4, w3);
+			p += 16;
+		} while (p <= limit);
+		ha = xr(a1, 1) + xr(a2, 7) + xr(a3, 12) + xr(a4, 18);
+		hb = xr(b1, 1) + xr(b2, 7) + xr(b3, 12) + xr(b4, 18);
+	} else {
+		ha = sa + P5;
+		hb = sb + P5;
+	}
+	ha += count;
+	hb += count;
+	while (end - p >= 4) {
+		const u32 w = xrd(p) * P3;
+		ha = xr(ha + w, 17) * P4;
+		hb = xr(hb + w, 17) * P4;
+		p += 4;
+	}
+	while (p < end) {
+		const u32 w = *p++ * P5;
+		ha = xr(ha + w, 11) * P1;
+		hb = xr(hb + w, 11) * P1;
+	}
+	return (static_cast<u64>(xaval(hb)) << 32) | xaval(ha);
+}
+
+u64 CRC_CalculatePalette( u64 crc, const void * buffer, u32 count )
+{
+	/* the first 2 bytes of every 8: gather them and hash once */
+	u16 entries[256];
+	const u8 *p = (const u8*) buffer;
+	if (count > 256)
+		count = 256;
+	for (u32 i = 0; i < count; ++i, p += 8)
+		memcpy(&entries[i], p, 2);
+	return CRC_Calculate(crc, entries, count * 2);
