+/* compile thread mode: runs the compiled block at pc if there is one; else starts its compile
+ * (when none is in flight) and interprets the block meanwhile.
+ * Interrupts are taken at the ends of blocks in dynarec mode, as cc_interrupt does. */
+static void *ctr64_ct_run(u_int pc)
+{
+  struct r4300_core* r4300=&g_dev.r4300;
+  struct new_dynarec_hot_state* state=&r4300->new_dynarec_hot_state;
+  for(;;) {
+    void *a=ctr64_lookup(pc); /* compiled code runs, also during a compile */
+    if(a) return a;
+    const int n=ctr64_ct_usable(pc);
+    if(n<=0) { ctr64_ct_sync(); return get_addr(pc); } /* compiled here */
+    if(!ctr_jit_thread_busy) ctr64_ct_post(pc);
+    cp0_update_count(r4300); /* dynarec: COUNT from next_interrupt and cycle_count */
+    r4300->emumode=EMUMODE_PURE_INTERPRETER;
+    ctr64_interp_active=1;
+    struct precomp_instr *dyna_pc=*r4300_pc_struct(r4300); /* fake_pc: the dynarec's COP0 helpers use it */
+    *r4300_pc_struct(r4300)=&r4300->interp_PC;
+    r4300->interp_PC.addr=pc;
+    r4300->cp0.last_addr=pc;
+    r4300->delay_slot=0;
+    int k;
+    for(k=0;k<n;k++) {
+      const u_int before=r4300->interp_PC.addr;
+      ctr64_interpret_opcode(r4300);
+      if(r4300->interp_PC.addr!=before+4) { k++; break; }
+    }
+    cp0_update_count(r4300); /* the instructions after the last jump */
+    r4300->emumode=EMUMODE_DYNAREC;
+    *r4300_pc_struct(r4300)=dyna_pc;
+    ctr64_interp_active=0;
+    ctr64_interp_blocks++;
+    ctr64_interp_insns+=k;
+    pc=r4300->interp_PC.addr;
+    state->pcaddr=pc;
+    if(*r4300_stop(r4300)) { ctr64_ct_sync(); return NULL; } /* the stub stops */
+    if(state->cycle_count>=0) {
+      state->pending_exception=0;
+      if(!ctr_jit_thread_busy) dynarec_gen_interrupt();
+      else {
+        /* dynarec_gen_interrupt without clean_blocks (compiler structures) */
+        cp0_update_count(r4300);
+        r4300->delay_slot=0;
+        gen_interrupt(r4300);
+      }
+      if(*r4300_stop(r4300)) { ctr64_ct_sync(); return NULL; }
+      if(state->pending_exception) {
+        state->pending_exception=0;
+        pc=state->pcaddr;
+      }
+    }
+  }
+}
